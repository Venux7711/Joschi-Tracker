# Supabase – Projekt-URL und öffentlicher Schlüssel (stehen im Browser, kein Geheimnis)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier

# Supabase – Admin-Schlüssel. Umgeht RLS, nur serverseitig verwendet.
# Supabase-Dashboard → Project Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key-hier

# Web-Push. Schlüsselpaar erzeugen mit:  npx web-push generate-vapid-keys
# VAPID_EMAIL braucht das Präfix "mailto:", sonst startet der Build nicht.
VAPID_EMAIL=mailto:du@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=dein-vapid-public-key
VAPID_PRIVATE_KEY=dein-vapid-private-key

# KI-Auswertung, Chat und Dosenscan (Google Gemini)
GOOGLE_AI_KEY=dein-google-ai-key

# Nährwerte von Produktseiten laden (optional – ohne den Schlüssel
# funktioniert nur die manuelle Eingabe im Vorrat)
FIRECRAWL_API_KEY=dein-firecrawl-key
